# BHARAT LOAD RAKSHAK - Environment Configuration

# Execution Mode: LOCAL or SAP
APP_MODE=LOCAL

# Demo Mode: true or false (clearly tags demo telemetry)
DEMO_MODE=false

# Node Environment
NODE_ENV=development
PORT=4000
WEBSOCKET_PORT=4001

# MQTT Broker Settings
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=bharatloadrakshak

# Local Database
SQLITE_DB_PATH=./db.sqlite

# SAP BTP & HANA Cloud Credentials (used when APP_MODE=SAP)
SAP_BTP_URL=
SAP_HANA_HOST=
SAP_HANA_PORT=443
SAP_HANA_USER=
SAP_HANA_PASSWORD=
SAP_EVENT_MESH_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_AUTH_URL=

# ML Microservice URL
ML_SERVICE_URL=http://localhost:5000
